# Optional overrides — copy to .env only when you need to change defaults.
# All other settings use values from app/config.py (Settings).
#
# LLM_CONTEXT_SIZE=32768

# GOOGLE_CREDENTIALS_PATH=./credentials.json
# GOOGLE_TOKEN_PATH=./token.json
# GOOGLE_CALENDAR_TIMEZONE=Europe/Helsinki
# Comma-separated calendar IDs nano should show. Default: primary.
# Run `nano-core google-calendars` to list IDs from your account.
# GOOGLE_CALENDAR_IDS=primary,work@company.com,abc123@group.calendar.google.com

# API_KEY=change-me
# CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Required for direct cross-origin dev (e.g. UI on localhost:3000, API on nano.local:8000).
# PATCH /api/timers and /api/stopwatches need this when not proxied through the UI dev server.
# API_BIND_HOST=0.0.0.0
# API_BIND_PORT=8000
# AUTO_UPDATE_ON_START=true
# AUTO_UPDATE_BRANCH=main
# AUTO_UPDATE_INSTALL=false
# REBOOT_ENABLED=true
# SERVICE_RESTART_ENABLED=true
# SERVICE_UNIT_NAME=nano-core

# VOICE_INPUT_ENABLED=false
# VOICE_INPUT_DEVICE=
# VOICE_OUTPUT_DEVICE=
# STT_MODEL_PATH=./models/vosk-model-small-en-us-0.15
# VOICE_WAKE_PHRASE=hey nano
# VOICE_PLAYBACK_MODE=both

# WEATHER_TIMEOUT_SECONDS=10
