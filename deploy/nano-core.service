[Unit]
Description=Nano Core API
After=network-online.target hailo-ollama.service
Wants=network-online.target hailo-ollama.service

[Service]
Type=simple
User=nano
WorkingDirectory=/home/nano/nano-core
EnvironmentFile=-/home/nano/nano-core/.env
ExecStartPre=/home/nano/nano-core/deploy/wait-for-llm.sh
ExecStart=/home/nano/nano-core/.venv/bin/nano-core serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
